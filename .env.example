# Mapbox Access Token
# Get yours at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Google Maps API Key for /photoreal-3d
# Enable Maps JavaScript API and restrict this key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional for /cesium-3d if using Cesium ion services/assets.
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here
