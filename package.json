{
  "name": "gallax",
  "version": "0.1.0",
  "description": "Multiplayer world map game with resource gathering and building",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "server": "tsx geckos-server/src/server.ts",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "cf:types": "wrangler types",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:tail": "wrangler tail",
    "test:multiplayer": "node tools/test-twinwire.mjs"
  },
  "dependencies": {
    "@geckos.io/snapshot-interpolation": "^1.1.1",
    "@simonwep/pickr": "^1.9.1",
    "emoji-mart": "^5.6.0",
    "emoji-picker-element": "^1.29.1",
    "h3-js": "^4.4.0",
    "mapbox-gl": "^3.9.4",
    "pixi.js": "^8.6.6",
    "twinwire": "2.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260302.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.2.1",
    "jsdom": "^29.0.2",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.4",
    "wrangler": "^4.67.0"
  },
  "optionalDependencies": {
    "node-datachannel": "^0.33.4"
  }
}
