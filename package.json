{
  "name": "gallax",
  "version": "0.1.0",
  "description": "Multiplayer world map game with resource gathering and building",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "npx tsx server/index.ts",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "cf:types": "wrangler types",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "mapbox-gl": "^3.9.4",
    "pixi.js": "^8.6.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260302.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/ws": "^8.5.14",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.67.0"
  }
}
